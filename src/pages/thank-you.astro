---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thank You! Your Request Has Been Received | OSBIC"
  description="Thank you for requesting a business consultation with OSBIC. Our senior advisor in Muscat will connect with you shortly."
>
  <main class="min-h-screen bg-[#FAF8FF] flex flex-col justify-between pt-12 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto w-full pt-8 sm:pt-16">
      
      <!-- Brand Header -->
      <div class="flex items-center justify-center gap-3 mb-8">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl overflow-hidden shadow-md flex items-center justify-center shrink-0 border border-[#3393D1]/20">
          <img
            src="/Artboard 1@3x-1.png"
            alt="OSBIC Logo"
            class="w-full h-full object-cover scale-[1.04]"
            loading="eager"
          />
        </div>
        <span class="font-bold text-2xl text-[#006192] tracking-tight">OSBIC</span>
      </div>

      <!-- Success Card -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl shadow-[#3393D1]/10 border border-[#E2E8F0] text-center relative overflow-hidden">
        
        <!-- Ambient top badge -->
        <div class="w-20 h-20 bg-[#10B981]/10 text-[#10B981] rounded-full flex items-center justify-center mx-auto mb-6 ring-8 ring-[#10B981]/5">
          <span class="material-symbols-outlined text-[42px] font-bold">
            check_circle
          </span>
        </div>

        <span class="inline-block px-3 py-1 rounded-full bg-[#10B981]/10 text-[#006947] text-xs font-bold uppercase tracking-wider mb-3">
          Consultation Request Confirmed
        </span>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#131B2E] tracking-tight mb-3">
          Thank You, <span id="client-name" class="text-[#006192]">Valued Client</span>
        </h1>

        <p class="text-sm sm:text-base text-[#475569] leading-relaxed max-w-lg mx-auto mb-8">
          We have received your business inquiry. A Senior Corporate Advisor has been assigned to your profile and will contact you.
        </p>

      

        <!-- Fast Track Contact Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a
            href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20just%20submitted%20the%20consultation%20form%20and%20would%20like%20to%20connect%20with%20my%20advisor."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#10B981] hover:bg-[#059669] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg shadow-[#10B981]/25 transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
            </svg>
            <span>Chat Immediately on WhatsApp</span>
          </a>

          <a
            href="/"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#F2F3FF] hover:bg-[#E2E7FF] text-[#006192] font-bold text-sm flex items-center justify-center gap-1.5 transition-all"
          >
            <span class="material-symbols-outlined text-[18px]">home</span>
            <span>Return to Homepage</span>
          </a>
        </div>

      </div>

    </div>

    <div class="text-center text-xs text-[#475569] mt-8">
      © {new Date().getFullYear()} OSBIC Business & Legal Consulting LLC • Muscat, Sultanate of Oman
    </div>
  </main>
</Layout>

<script>
  // Personalize message with submitted name
  const storedName = sessionStorage.getItem('osbic_lead_name');
  const nameEl = document.getElementById('client-name');
  if (storedName && nameEl) {
    nameEl.textContent = storedName;
  }
</script>
