---
const services = [
  {
    step: "01",
    title: "Business Activity Selection",
    icon: "category"
  },
  {
    step: "02",
    title: "Trade Name Registration",
    icon: "draw"
  },
  {
    step: "03",
    title: "Commercial Registration (CR)",
    icon: "domain"
  },
  {
    step: "04",
    title: "License Assistance",
    icon: "verified_user"
  },
  {
    step: "05",
    title: "Government Approvals",
    icon: "account_balance"
  },
  {
    step: "06",
    title: "Post-Registration Support",
    icon: "support_agent"
  }
];
---

<section id="services" class="w-full bg-[#FAF8FF] py-12 sm:py-20 lg:py-24 relative border-t border-[#E2E8F0]/80 scroll-mt-20 md:scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-14 gap-4 sm:gap-6">
      <div class="max-w-2xl">
        <span class="text-[11px] sm:text-sm font-bold text-[#006192] tracking-widest uppercase mb-1.5 sm:mb-2.5 block">
          End-to-End Solutions
        </span>
        <h2 class="text-xl sm:text-3xl lg:text-4xl font-extrabold text-[#131B2E] tracking-tight leading-tight">
          Comprehensive Company Registration Services
        </h2>
        <p class="text-xs sm:text-base text-[#475569] mt-2 sm:mt-3 leading-relaxed">
          From initial company incorporation to residency and full operational licensing, OSBIC handles every stage with speed and precision.
        </p>
      </div>

      <a
        href="#lead-form"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-[#006192] hover:text-[#3393D1] bg-[#EAEDFF] hover:bg-[#E2E7FF] px-4 py-2.5 sm:px-5 sm:py-3 rounded-xl transition-all self-start md:self-end shrink-0 shadow-sm"
      >
        <span>Explore custom package</span>
        <span class="material-symbols-outlined text-[16px] sm:text-[18px]">arrow_forward</span>
      </a>
    </div>

    <!-- Split Showcase: Left Omani Consultant Visual (pro_.jpg) + Right 6 Services Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 lg:gap-8 items-stretch">
      
      <!-- Left Column (5 cols): Real Omani Advisor Visual Card -->
      <div class="lg:col-span-5 relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-md shadow-[#3393D1]/5 border border-[#E2E8F0] min-h-[340px] sm:min-h-[420px] lg:min-h-full flex flex-col justify-end p-4 sm:p-7 group">
        <!-- Background Image (pro_.jpg) -->
        <img
          src="/office-img/pro_.jpg"
          alt="OSBIC Senior Omani PRO & Legal Consultant greeting investor"
          class="absolute inset-0 w-full h-full object-cover object-[center_15%] group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
        
        <!-- Smooth Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#001D30]/90 via-[#002D4A]/40 to-transparent"></div>

        <!-- Floating Glassmorphic Trust Card -->
        <div class="relative z-10 bg-white/95 backdrop-blur-md p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-white/60 shadow-xl space-y-2 sm:space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="inline-flex items-center gap-1 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full bg-[#006947]/10 text-[#006947] text-[10px] sm:text-xs font-bold">
              <span class="material-symbols-outlined text-[14px] sm:text-[16px]">verified</span>
              <span>Accredited Omani PRO</span>
            </div>
            <span class="text-[10px] sm:text-xs font-bold text-[#006192] flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-[#F59E0B]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span>4.5 Rated</span>
            </span>
          </div>

          <div>
            <h4 class="text-sm sm:text-base font-extrabold text-[#131B2E]">
              Dedicated Government & Legal Liaison
            </h4>
            <p class="text-[11px] sm:text-xs text-[#475569] mt-0.5 leading-relaxed">
              Direct liaison with MOCIIP, Ministry of Labour, ROP, and all major Omani commercial banks.
            </p>
          </div>

          <div class="pt-1.5 sm:pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-[10px] sm:text-xs font-semibold text-[#006192]">
            <span>100% In-House Team</span>
            <span>Muscat, Oman</span>
          </div>
        </div>
      </div>

      <!-- Right Column (7 cols): 6 Services in 2-Column Grid -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 md:gap-5">
        {services.map((service) => (
          <a
            href="#lead-form"
            class="bg-white p-4 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl shadow-sm hover:shadow-xl hover:shadow-[#3393D1]/12 border border-[#E2E8F0] hover:border-[#3393D1]/50 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group cursor-pointer relative overflow-hidden"
          >
            <!-- Top Row: Icon & Step Badge -->
            <div class="flex items-center justify-between mb-3 sm:mb-4">
              <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-lg sm:rounded-xl bg-[#EAEDFF] text-[#006192] flex items-center justify-center group-hover:bg-[#3393D1] group-hover:text-white transition-all duration-300 shadow-sm">
                <span class="material-symbols-outlined text-[20px] sm:text-[24px]">
                  {service.icon}
                </span>
              </div>
              <span class="text-[10px] sm:text-xs font-bold text-[#475569]/70 bg-[#F1F5F9] group-hover:bg-[#EAEDFF] group-hover:text-[#006192] px-2 py-0.5 sm:px-2.5 sm:py-0.5 rounded-full transition-colors font-mono">
                {service.step}
              </span>
            </div>

            <!-- Service Title -->
            <div class="mb-2.5 sm:mb-3">
              <h3 class="text-sm sm:text-base md:text-lg font-bold text-[#131B2E] group-hover:text-[#006192] transition-colors leading-snug">
                {service.title}
              </h3>
            </div>

            <!-- Bottom Status & Link -->
            <div class="pt-2 sm:pt-3 border-t border-[#F2F3FF] flex items-center justify-between text-[11px] sm:text-xs font-semibold">
              <span class="flex items-center gap-1 text-[#006947]">
                <span class="material-symbols-outlined text-[13px] sm:text-[15px] text-[#10B981]">check_circle</span>
                <span>100% Assisted</span>
              </span>
              <span class="inline-flex items-center gap-0.5 text-[#006192] group-hover:text-[#3393D1] font-bold">
                <span>Request quote</span>
                <span class="material-symbols-outlined text-[13px] sm:text-[14px] transition-transform group-hover:translate-x-1">arrow_forward</span>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

