---
const faqs = [
  {
    question: "What is company registration in Oman?",
    answer: `<p><strong>Company registration in Oman</strong> is the official legal process of establishing a corporate entity through the Ministry of Commerce, Industry and Investment Promotion (MOCIIP). It involves reserving a trade name, securing a Commercial Registration (CR) certificate, and obtaining the necessary operational approvals to legally conduct business across the Sultanate.</p>`,
    open: true
  },
  {
    question: "Can foreigners register a company in Oman?",
    answer: `<p>Yes. Under the Foreign Capital Investment Law (FCIL), international investors can obtain 100% foreign ownership for their <strong>company registration in Oman</strong> across most commercial, industrial, and service sectors without requiring a local Omani partner. Certain restricted activities on the national negative list remain exclusively reserved for Omani nationals.</p>`,
    open: false
  },
  {
    question: "How much does company registration in Oman cost?",
    answer: `<p>The total cost for <strong>company registration in Oman</strong> depends on your legal structure (such as an LLC, Single Person Company, or Free Zone entity), chosen commercial activities, and physical space requirements. The total budget typically encompasses:</p>
    <ul class="list-disc pl-5 mt-3 space-y-2 text-[#475569]">
      <li><strong>Government & CR Fees:</strong> Commercial registration, trade name reservation, and initial Chamber of Commerce (OCCI) dues.</li>
      <li><strong>Municipal Licensing & Leases:</strong> Municipality approvals based on your registered commercial office or workspace.</li>
      <li><strong>Investor & Employment Visas:</strong> Application and resident card issuance fees.</li>
    </ul>`,
    open: false
  },
  {
    question: "How long does the company registration process take?",
    answer: `<p>Initial <strong>company registration</strong> and issuance of the Commercial Registration (CR) certificate via the Oman Business Platform can take between 1 to 5 working days. The overall setup timeline—including specialized activity permits, municipality licensing, and corporate bank account activation—typically takes 2 to 4 weeks depending on regulatory approvals.</p>`,
    open: false
  },
  {
    question: "Do you provide licensing support after company registration?",
    answer: `<p>Yes. Beyond obtaining your initial <strong>company registration in Oman</strong>, full end-to-end licensing assistance covers municipal approvals (Baladiya), sector-specific ministry permits, Oman Chamber of Commerce & Industry (OCCI) registration, Tax Identification Number (TIN) setup, and investor visa processing.</p>`,
    open: false
  }
];
---

<section id="faq" class="w-full py-16 sm:py-20 lg:py-24 bg-white border-t border-[#E2E8F0]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#131B2E] tracking-tight">
        Frequently Asked Questions
      </h2>
      <div class="h-1 w-16 bg-[#3393D1] mx-auto mt-4 rounded-full"></div>
      <p class="text-sm sm:text-base text-[#475569] mt-3">
        Everything you need to know about setting up and running your company in Oman.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details
          class="group bg-[#FAF8FF] rounded-2xl border border-[#E2E8F0] shadow-sm transition-all duration-200 overflow-hidden [&_summary::-webkit-details-marker]:hidden"
          open={faq.open}
        >
          <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6 text-base sm:text-lg font-bold text-[#131B2E] group-open:text-[#006192] select-none hover:bg-[#F2F3FF]/60 transition-colors">
            <span class="pr-4">{faq.question}</span>
            <span class="w-8 h-8 rounded-full bg-white border border-[#E2E8F0] flex items-center justify-center shrink-0 text-[#006192] group-open:rotate-180 group-open:bg-[#006192] group-open:text-white transition-transform duration-300">
              <span class="material-symbols-outlined text-[20px]">expand_more</span>
            </span>
          </summary>
          <div class="px-5 sm:px-6 pb-6 pt-1 text-sm sm:text-base text-[#475569] leading-relaxed border-t border-[#F2F3FF]/80 space-y-2">
            <div set:html={faq.answer} />
          </div>
        </details>
      ))}
    </div>

    <!-- Still have questions footer -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#002D4A] to-[#001D30] text-white border border-white/10 shadow-xl shadow-[#001D30]/15 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 sm:gap-6 text-center sm:text-left flex-col sm:flex-row">
        <!-- Dual Action Round Icons -->
        <div class="flex items-center -space-x-2 shrink-0">
          <a
            href="tel:+96872596531"
            aria-label="Call OSBIC"
            title="Call +968 7259 6531"
            class="w-12 h-12 rounded-full bg-[#131B2E] border-2 border-[#3393D1] text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all z-10"
          >
            <span class="material-symbols-outlined text-[20px]">call</span>
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp OSBIC"
            title="Chat on WhatsApp"
            class="w-12 h-12 rounded-full bg-[#10B981] border-2 border-white text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all z-20"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
            </svg>
