---
const advantages = [
  {
    icon: "account_balance",
    title: "100% Foreign Ownership",
    subtitle: "Foreign Capital Investment Law (FCIL)",
    description: "Retain 100% equity and operational control of your company in Oman without requiring a local Omani sponsor or partner.",
    tag: "Full Autonomy"
  },
  {
    icon: "payments",
    title: "0% Personal Income Tax",
    subtitle: "Maximum Capital Retention",
    description: "Benefit from zero personal income tax, 100% repatriation of capital and profits, and highly competitive corporate tax rates.",
    tag: "High Profitability"
  },
  {
    icon: "public",
    title: "Strategic Global Gateway",
    subtitle: "Direct Access to GCC & Global Markets",
    description: "Prime geographic positioning connecting Asia, Africa, and Europe, backed by world-class deep-water ports, free zones, and modern airports.",
    tag: "Global Trade"
  }
];
---

<section id="why-oman" class="w-full bg-[#FAF9F6] py-16 sm:py-20 lg:py-24 border-y border-[#E2E8F0] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs sm:text-sm font-bold text-[#006192] tracking-widest uppercase mb-2.5 block">
        Strategic Advantages
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#131B2E] tracking-tight">
        Why Establish Your Business in Oman?
      </h2>
      <div class="h-1 w-16 bg-[#3393D1] mx-auto mt-4 rounded-full"></div>
      <p class="text-sm sm:text-base text-[#475569] mt-4 max-w-2xl mx-auto leading-relaxed">
        The Sultanate of Oman offers one of the most investor-friendly regulatory environments in the MENA region, supported by Vision 2040 economic incentives.
      </p>
    </div>

    <!-- 3-Card Advantage Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {advantages.map((item) => (
        <div class="bg-white p-8 rounded-2xl shadow-md shadow-[#3393D1]/5 border border-[#E2E8F0] hover:shadow-xl hover:shadow-[#3393D1]/10 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-[#EAEDFF] text-[#006192] flex items-center justify-center group-hover:bg-[#3393D1] group-hover:text-white transition-colors duration-300 shadow-sm">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">
                  {item.icon}
                </span>
              </div>
              <span class="text-[11px] font-bold text-[#006947] bg-[#F5FFF6] border border-[#6FFBBE]/40 px-2.5 py-1 rounded-full uppercase tracking-wider">
                {item.tag}
              </span>
            </div>

            <h3 class="text-xl font-bold text-[#131B2E] mb-1 group-hover:text-[#006192] transition-colors">
              {item.title}
            </h3>
            <p class="text-xs font-semibold text-[#006192] mb-3">
              {item.subtitle}
            </p>
            <p class="text-sm text-[#475569] leading-relaxed">
              {item.description}
            </p>
          </div>

          <a
            href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 pt-4 border-t border-[#E2E8F0] flex items-center text-xs font-bold text-[#006192] group-hover:text-[#3393D1] transition-colors"
          >
            <span>Learn setup requirements</span>
            <span class="material-symbols-outlined text-[16px] ml-1 transition-transform group-hover:translate-x-1">
              arrow_forward
            </span>
          </a>
        </div>
      ))}
    </div>

    <!-- Quick Consultation Strip (Call Us / WhatsApp + Free Consultation Pill) -->
    <div class="mt-12 sm:mt-16 bg-gradient-to-r from-[#002D4A] to-[#001D30] rounded-3xl p-6 sm:p-8 text-white shadow-xl shadow-[#001D30]/20 flex flex-col md:flex-row items-center justify-between gap-6 border border-white/10">
      <div class="flex items-center gap-4 sm:gap-6 text-center sm:text-left flex-col sm:flex-row">
        <!-- Dual Action Round Icons -->
        <div class="flex items-center -space-x-2 shrink-0">
          <a
            href="tel:+96872596531"
            aria-label="Call OSBIC"
            title="Call +968 7259 6531"
            class="w-12 h-12 rounded-full bg-[#131B2E] border-2 border-[#3393D1] text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all z-10"
          >
            <span class="material-symbols-outlined text-[20px]">call</span>
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp OSBIC"
            title="Chat on WhatsApp"
            class="w-12 h-12 rounded-full bg-[#10B981] border-2 border-white text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all z-20"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
            </svg>
          </a>
        </div>

        <div>
          <div class="text-xs sm:text-sm font-semibold text-[#6FFBBE] tracking-wider uppercase">
            Call Us / Whatsapp
          </div>
          <a
            href="tel:+96872596531"
            class="text-xl sm:text-2xl font-black text-white tracking-tight hover:text-[#6FFBBE] transition-colors block mt-0.5"
          >
            +968 7259 6531
          </a>
        </div>
      </div>

      <a
        href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 sm:px-8 sm:py-4 rounded-full bg-gradient-to-r from-[#10B981] via-[#059669] to-[#047857] text-white font-extrabold text-sm sm:text-base tracking-wide shadow-lg shadow-emerald-500/40 hover:shadow-emerald-500/60 hover:scale-105 active:scale-95 transition-all duration-300 border border-white/30 shrink-0 w-full sm:w-auto"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
        </svg>
        <span>Get a Free Consultation</span>
      </a>
    </div>

  </div>
</section>
