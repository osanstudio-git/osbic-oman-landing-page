---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
---

<footer class="w-full bg-[#EAEDFF]/80 pt-16 pb-24 md:pb-12 border-t border-[#E2E8F0] relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 mb-12">
      
      <!-- Company Bio (5 cols on lg) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl overflow-hidden shadow-md flex items-center justify-center shrink-0 border border-[#3393D1]/20">
            <Image
              src={logoImg}
              alt="OSBIC Logo"
              class="w-full h-full object-cover scale-[1.04]"
              loading="lazy"
              width={88}
              height={88}
              format="webp"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-xl text-[#006192] tracking-tight leading-none">
              OSBIC
            </span>
            <span class="text-[10px] font-semibold text-[#475569] tracking-wider uppercase">
              Company Registration in Oman
            </span>
          </div>
        </div>

        <p class="text-sm text-[#475569] leading-relaxed max-w-sm">
          Driving frictionless business growth and institutional legal excellence in the heart of Oman. Certified partners for foreign direct investment and company incorporation.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white border border-[#CBD5E1] text-xs font-semibold text-[#006192]">
            <span class="material-symbols-outlined text-[16px] text-[#10B981]">verified</span>
            MOCIIP Accredited
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white border border-[#CBD5E1] text-xs font-semibold text-[#006192]">
            <span class="material-symbols-outlined text-[16px] text-[#10B981]">shield</span>
            100% Legal Compliance
          </span>
        </div>
      </div>

      <!-- Services List (3 cols on lg) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-bold text-[#131B2E] uppercase tracking-wider">
          Our Services
        </h4>
        <ul class="space-y-2.5 text-sm text-[#475569]">
          <li><a href="#services" class="hover:text-[#3393D1] transition-colors">Business Activity Selection</a></li>
          <li><a href="#services" class="hover:text-[#3393D1] transition-colors">Trade Name Registration</a></li>
          <li><a href="#services" class="hover:text-[#3393D1] transition-colors">Commercial Registration (CR)</a></li>
          <li><a href="#services" class="hover:text-[#3393D1] transition-colors">License Assistance</a></li>
          <li><a href="#services" class="hover:text-[#3393D1] transition-colors">Government Approvals</a></li>
          <li><a href="#services" class="hover:text-[#3393D1] transition-colors">Post-Registration Support</a></li>
        </ul>
      </div>

      <!-- Head Office & Contact Details (4 cols on lg) -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="text-xs font-bold text-[#131B2E] uppercase tracking-wider">
          Muscat Head Office
        </h4>
        <div class="space-y-3 text-sm text-[#475569]">
          <div class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[#006192] text-[18px] shrink-0 mt-0.5">location_on</span>
            <div class="flex flex-col">
              
              <span class="leading-relaxed">Near Al Maha Petrol Pump & Asas Service Center, Building No: 271, Office No: 7, Grand Mosque St, 101</span>
            </div>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[#006192] text-[18px] shrink-0">mail</span>
            <a href="mailto:marketing@osbic.net" class="hover:text-[#3393D1] transition-colors font-medium">marketing@osbic.net</a>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[#006192] text-[18px] shrink-0">call</span>
            <a href="tel:+96872596531" class="hover:text-[#3393D1] transition-colors font-semibold text-[#131B2E]">+968 7259 6531</a>
          </div>
        </div>

        <!-- Social Channels -->
        <div class="flex items-center gap-2.5 pt-2">
          <a
            href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-9 h-9 rounded-lg bg-white border border-[#CBD5E1] text-[#10B981] hover:bg-[#10B981] hover:text-white flex items-center justify-center transition-all shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
          </a>
          <a
            href="tel:+96872596531"
            aria-label="Phone Call"
            class="w-9 h-9 rounded-lg bg-white border border-[#CBD5E1] text-[#006192] hover:bg-[#006192] hover:text-white flex items-center justify-center transition-all shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px]">call</span>
          </a>
          <a
            href="mailto:marketing@osbic.net"
            aria-label="Email"
            class="w-9 h-9 rounded-lg bg-white border border-[#CBD5E1] text-[#475569] hover:bg-[#006192] hover:text-white flex items-center justify-center transition-all shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px]">mail</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Copyright & Terms -->
    <div class="pt-8 border-t border-[#CBD5E1]/60 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-medium text-[#475569]">
      <p>© {new Date().getFullYear()} OSBIC | Business Setup In Oman.   All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#faq" class="hover:text-[#3393D1] transition-colors">Privacy Policy</a>
        <a href="#faq" class="hover:text-[#3393D1] transition-colors">Terms of Service</a>
        <a href="#faq" class="hover:text-[#3393D1] transition-colors">Legal Disclaimer</a>
      </div>
    </div>
  </div>
</footer>
