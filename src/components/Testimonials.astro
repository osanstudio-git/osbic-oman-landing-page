---
const testimonials = [
  {
    name: "Zia ur Rahman",
    time: "10 months ago",
    detail: "8 reviews • 2 photos",
    initials: "Z",
    avatarBg: "bg-[#5B21B6] text-white",
    quote: "Services are fast and spontaneous. We deal with Mr. Ayoob and Mr. Suvaid they were very helpful and quick in their work. I wish the good future endeavour.",
    rating: 5
  },
  {
    name: "Rajan Purushothaman",
    time: "5 months ago",
    detail: "1 review",
    initials: "R",
    avatarBg: "bg-[#00796B] text-white",
    quote: "Highly recommended for anyone seeking reliable and efficient business services.",
    rating: 5
  },
  {
    name: "Waleed Sayyed",
    time: "a year ago",
    detail: "5 reviews • 1 photo",
    initials: "W",
    avatarBg: "bg-[#15803D] text-white",
    quote: "Friendly service, follow up with customers. Appreciated 👏 Really Satisfied 💯",
    rating: 5
  },
  {
    name: "Omar Mohamed",
    time: "a year ago",
    detail: "2 reviews",
    initials: "O",
    avatarBg: "bg-[#006192] text-white",
    quote: "اوسبك من الشركات المتساهلة في تخليص جميع المعاملات للمستثمرين انصح بالتعامل معاهم 💥",
    translation: "OSBIC is one of the smoothest companies in processing all transactions for investors. Highly recommend dealing with them.",
    rating: 5
  }
];
---

<section id="testimonials" class="w-full py-16 sm:py-20 lg:py-24 bg-[#FAF8FF] relative overflow-hidden scroll-mt-20 md:scroll-mt-24 border-t border-[#E2E8F0]/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header with 5.0 Google Reviews Badge -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 sm:mb-14 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs sm:text-sm font-bold text-[#006192] tracking-widest uppercase mb-2 block">
          Client Feedback & Social Proof
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#131B2E] tracking-tight mb-4">
          What Our Clients Say
        </h2>
        
        <!-- Google Review Rating Pill -->
        <div class="inline-flex flex-wrap items-center gap-3 bg-white px-4 py-2 rounded-2xl border border-[#E2E8F0] shadow-sm">
          <div class="flex items-center gap-1.5">
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span class="text-xs font-bold text-[#131B2E]">Google Reviews</span>
          </div>

          <div class="flex text-[#F59E0B]">
            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star_half</span>
          </div>

          <span class="text-xs font-bold bg-[#EAEDFF] text-[#006192] px-2.5 py-0.5 rounded-full">
            4.5 / 5.0 Rating
          </span>
          <span class="text-xs text-[#475569] font-medium">
            (23 Google reviews)
          </span>
        </div>
      </div>

      <!-- Navigation Arrows for Testimonial Cards -->
      <div class="hidden sm:flex items-center gap-2">
        <button
          id="testimonial-prev"
          aria-label="Previous Testimonial"
          class="w-11 h-11 rounded-xl bg-white border border-[#E2E8F0] flex items-center justify-center text-[#131B2E] hover:bg-[#3393D1] hover:text-white hover:border-[#3393D1] shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </button>
        <button
          id="testimonial-next"
          aria-label="Next Testimonial"
          class="w-11 h-11 rounded-xl bg-white border border-[#E2E8F0] flex items-center justify-center text-[#131B2E] hover:bg-[#3393D1] hover:text-white hover:border-[#3393D1] shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
        </button>
      </div>
    </div>

    <!-- Testimonial Cards Grid -->
    <div id="testimonial-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 overflow-x-auto pb-4 scroll-smooth">
      {testimonials.map((item) => (
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-md shadow-[#3393D1]/5 border border-[#E2E8F0] hover:shadow-xl hover:shadow-[#3393D1]/10 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between relative group">
          
          <div>
            <!-- Top Row: Rating & Google Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex text-[#F59E0B]">
                {[...Array(item.rating)].map(() => (
                  <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                ))}
              </div>
              <div class="flex items-center gap-1 text-[11px] font-semibold text-[#475569] bg-[#F1F5F9] px-2.5 py-0.5 rounded-md whitespace-nowrap shrink-0">
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>{item.time}</span>
              </div>
            </div>

            <!-- Quote Text -->
            <p class="text-sm text-[#131B2E] leading-relaxed mb-2.5 font-normal">
              "{item.quote}"
            </p>

            {item.translation && (
              <p class="text-xs text-[#64748B] leading-relaxed italic mb-4">
                ({item.translation})
              </p>
            )}
          </div>

          <!-- Client Author Info -->
          <div class="flex items-center gap-3.5 pt-4 border-t border-[#F2F3FF]">
            <div class={`w-10 h-10 rounded-full ${item.avatarBg} flex items-center justify-center font-bold text-sm shadow-sm shrink-0`}>
              {item.initials}
            </div>
            <div class="overflow-hidden">
              <h4 class="text-sm font-bold text-[#131B2E] truncate">
                {item.name}
              </h4>
              <p class="text-xs text-[#475569] truncate">
                {item.detail}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');
  const container = document.getElementById('testimonial-container');

  if (prevBtn && nextBtn && container) {
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -320, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: 320, behavior: 'smooth' });
    });
  }
</script>

