---
import PhoneInput from './PhoneInput.astro';
---

<section id="cta-banner" class="w-full bg-[#FAF8FF] py-16 sm:py-20 lg:py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-[#006192] overflow-hidden shadow-2xl shadow-[#006192]/20 border border-[#3393D1]/30 grid grid-cols-1 lg:grid-cols-12 relative">
      
      <!-- Left Column: Background Image with Content Overlay -->
      <div class="lg:col-span-7 relative p-8 sm:p-10 lg:p-12 flex flex-col justify-between min-h-[440px] lg:min-h-[560px] text-white overflow-hidden">
        <!-- Background Image -->
        <img
          src="/office-img/visa_.jpg"
          alt="OSBIC Oman Corporate Office and Visa Services"
          class="absolute inset-0 w-full h-full object-cover object-center sm:object-[center_15%] lg:object-[center_10%]"
          loading="lazy"
        />
        
        <!-- Light Gradient Dark Tint Overlay for Optimal Image Visibility & Contrast -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#001A2C]/90 via-[#002D4A]/50 to-[#001A2C]/30"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#001A2C]/70 via-transparent to-transparent"></div>

        <!-- Top Content on Left -->
        <div class="relative z-10 space-y-4 max-w-xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/40 text-white text-xs font-bold backdrop-blur-md border border-white/20 shadow-sm w-fit">
            <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
            <span>Fast-Track Corporate Setup</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight [text-wrap:balance] drop-shadow-md">
            Ready to Register Your Company in Oman?
          </h2>

          <p class="text-sm sm:text-base text-white/95 leading-relaxed font-normal pt-1 drop-shadow">
            Join 25,000+ registered enterprises. Our accredited legal consultants and PRO specialists structure your company with speed, compliance, and precision.
          </p>

          <!-- Key Value Points -->
          <ul class="space-y-2.5 pt-3">
            <li class="flex items-center gap-2.5 text-xs sm:text-sm font-semibold text-white drop-shadow">
              <span class="material-symbols-outlined text-[19px] text-[#6FFBBE] shrink-0 font-bold">verified</span>
              <span>100% Foreign Ownership Setup (FCIL Compliant)</span>
            </li>
            <li class="flex items-center gap-2.5 text-xs sm:text-sm font-semibold text-white drop-shadow">
              <span class="material-symbols-outlined text-[19px] text-[#6FFBBE] shrink-0 font-bold">speed</span>
              <span>Commercial Registration (CR) in 3 to 5 Business Days</span>
            </li>
            <li class="flex items-center gap-2.5 text-xs sm:text-sm font-semibold text-white drop-shadow">
              <span class="material-symbols-outlined text-[19px] text-[#6FFBBE] shrink-0 font-bold">account_balance</span>
              <span>Dedicated Bank Account & Investor Visa Assistance</span>
            </li>
          </ul>
        </div>

        <!-- Bottom Left: Direct WhatsApp & Call Quick Actions -->
        <div class="relative z-10 pt-8 mt-auto border-t border-white/20 flex flex-wrap items-center gap-3 sm:gap-4">
          <a
            href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-5 py-3 rounded-xl bg-[#10B981] hover:bg-[#059669] text-white font-bold text-xs sm:text-sm shadow-lg shadow-[#10B981]/30 transition-all active:scale-[0.98]"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
            </svg>
            <span>Chat on WhatsApp</span>
          </a>

          <a
            href="tel:+96872596531"
            class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-white/20 hover:bg-white/30 text-white font-bold text-xs sm:text-sm backdrop-blur-md border border-white/25 transition-all active:scale-[0.98] shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px] text-[#6FFBBE]">call</span>
            <span>+968 7259 6531</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Secondary High-Converting Lead Form -->
      <div class="lg:col-span-5 bg-white p-6 sm:p-8 lg:p-10 flex flex-col justify-center">
        <div class="mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#3393D1]/10 text-[#006192] text-xs font-bold mb-2">
            <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
            <span>Connect With Us</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-[#131B2E] tracking-tight">
            Start Your Business in Oman
          </h3>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">
            Fill in your details below for a free consultation and customized quote.
          </p>
        </div>

        <form id="cta-lead-capture-form" class="space-y-4" novalidate>
          <div id="cta-form-feedback" class="hidden p-3 rounded-xl text-sm font-medium"></div>

          <!-- Full Name -->
          <div class="space-y-1.5">
            <label for="cta-fullName" class="block text-xs font-bold text-[#131B2E] uppercase tracking-wider">
              Full Name <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[#707881] text-[20px] pointer-events-none">
                person
              </span>
              <input
                type="text"
                id="cta-fullName"
                name="fullName"
                required
                placeholder="e.g. John Doe"
                class="w-full h-11 pl-11 pr-4 rounded-xl bg-[#FAF8FF] border border-[#CBD5E1] text-[#131B2E] placeholder:text-[#707881]/70 text-sm font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3393D1] focus:border-transparent transition-all shadow-sm"
              />
            </div>
          </div>

          <!-- Email Address -->
          <div class="space-y-1.5">
            <label for="cta-email" class="block text-xs font-bold text-[#131B2E] uppercase tracking-wider">
              Email <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[#707881] text-[20px] pointer-events-none">
                mail
              </span>
              <input
                type="email"
                id="cta-email"
                name="email"
                required
                placeholder="e.g. john@company.com"
                class="w-full h-11 pl-11 pr-4 rounded-xl bg-[#FAF8FF] border border-[#CBD5E1] text-[#131B2E] placeholder:text-[#707881]/70 text-sm font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3393D1] focus:border-transparent transition-all shadow-sm"
              />
            </div>
          </div>

          <!-- Phone Number with Country Code -->
          <PhoneInput
            idPrefix="cta"
            name="phone"
            required={true}
            label="Phone / WhatsApp Number"
          />

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="cta-submit-btn"
              class="w-full h-12 rounded-xl bg-gradient-to-r from-[#3393D1] to-[#006192] hover:from-[#1F6E9F] hover:to-[#004B72] text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-lg shadow-[#3393D1]/25 hover:shadow-xl hover:shadow-[#3393D1]/35 transition-all active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed group/btn cursor-pointer"
            >
              <span id="cta-btn-text">Request Free Consultation</span>
              <span id="cta-btn-icon" class="material-symbols-outlined text-[20px] transition-transform group-hover/btn:translate-x-1">
                arrow_forward
              </span>
              <svg
                id="cta-btn-spinner"
                class="hidden animate-spin h-5 w-5 text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>

          <!-- Trust signals below button -->
          <div class="flex items-center justify-center gap-2 text-xs font-semibold text-[#006947] pt-1">
            <span class="material-symbols-outlined text-[18px]">verified_user</span>
            <span>100% Confidential</span>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const ctaForm = document.getElementById('cta-lead-capture-form') as HTMLFormElement | null;
  const ctaSubmitBtn = document.getElementById('cta-submit-btn') as HTMLButtonElement | null;
  const ctaBtnText = document.getElementById('cta-btn-text');
  const ctaBtnIcon = document.getElementById('cta-btn-icon');
  const ctaBtnSpinner = document.getElementById('cta-btn-spinner');
  const ctaFeedback = document.getElementById('cta-form-feedback');

  const ctaPhoneInput = document.getElementById('cta-phone-input') as HTMLInputElement | null;
  const ctaFullPhoneHidden = document.getElementById('cta-full-phone') as HTMLInputElement | null;
  const ctaErrorBox = document.getElementById('cta-phone-error');

  let isSubmitting = false;

  if (ctaForm && ctaSubmitBtn && ctaBtnText && ctaBtnIcon && ctaBtnSpinner && ctaFeedback) {
    ctaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      const fullName = (document.getElementById('cta-fullName') as HTMLInputElement)?.value?.trim();
      const email = (document.getElementById('cta-email') as HTMLInputElement)?.value?.trim();
      const rawPhone = ctaPhoneInput?.value?.trim();
      const fullPhone = ctaFullPhoneHidden?.value?.trim();

      // Basic client-side validation
      if (!fullName || !email || !rawPhone) {
        ctaFeedback.className = 'p-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200 block';
        ctaFeedback.textContent = 'Please fill in all required fields.';
        return;
      }

      // Email format check
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        ctaFeedback.className = 'p-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200 block';
        ctaFeedback.textContent = 'Please provide a valid email address.';
        return;
      }

      // Check if phone error is currently visible
      if (ctaErrorBox && !ctaErrorBox.classList.contains('hidden')) {
        ctaFeedback.className = 'p-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200 block';
        ctaFeedback.textContent = 'Please correct your phone number before submitting.';
        ctaPhoneInput?.focus();
        return;
      }

      const digitsOnly = rawPhone.replace(/[^\d]/g, '');
      if (digitsOnly.length < 6) {
        ctaFeedback.className = 'p-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200 block';
        ctaFeedback.textContent = 'Please enter a valid phone number.';
        ctaPhoneInput?.focus();
        return;
      }

      isSubmitting = true;

      // Loading state
      ctaSubmitBtn.disabled = true;
      ctaBtnText.textContent = 'Processing...';
      ctaBtnIcon.classList.add('hidden');
      ctaBtnSpinner.classList.remove('hidden');
      ctaFeedback.classList.add('hidden');

      const formattedPhoneToSubmit = fullPhone || rawPhone;

      const leadPayload = {
        fullName,
        email,
        phone: formattedPhoneToSubmit,
        serviceType: '',
        source: 'OSBIC Bottom CTA Form',
        timestamp: new Date().toISOString(),
        referrer: document.referrer || 'Direct'
      };

      const webhookUrl = import.meta.env.PUBLIC_WEBHOOK_URL || "https://script.google.com/macros/s/AKfycbwIz-3kYA_IC3BPoDzNQsEUUvGtArMxBrPVOMO4CaXGjKlilITjiuQ5I1-5dBcrYXJwiQ/exec";

      try {
        if (webhookUrl && webhookUrl.startsWith('http')) {
          fetch(webhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'text/plain;charset=utf-8'
            },
            body: JSON.stringify(leadPayload),
            keepalive: true
          }).catch((err) => console.warn('CTA Webhook log:', err));
        }
      } catch (err) {
        console.warn('CTA Webhook error:', err);
      }

      if (typeof window !== 'undefined' && (window as any).dataLayer) {
        (window as any).dataLayer.push({
          event: 'generate_lead',
          leadData: {
            service: 'Company Registration in Oman',
            hasEmail: Boolean(email),
            hasPhone: Boolean(rawPhone),
            fullPhone: formattedPhoneToSubmit,
            position: 'bottom_cta'
          }
        });
      }

      sessionStorage.setItem('osbic_lead_name', fullName);
      
      setTimeout(() => {
        window.location.href = '/thank-you';
      }, 700);
    });
  }
</script>
