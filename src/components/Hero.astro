---
import LeadForm from './LeadForm.astro';

const stats = [
  {
    value: "25,000+",
    label: "Company Registrations",
    subtext: "Successfully formed in Oman",
    icon: "corporate_fare"
  },
  {
    value: "18,000+",
    label: "Global Investors",
    subtext: "Across 45+ countries",
    icon: "public"
  },
  {
    value: "19+ Years",
    label: "Industry Experience",
    subtext: "Omani corporate law",
    icon: "workspace_premium"
  },
  {
    value: "100%",
    label: "Foreign Ownership",
    subtext: "FCIL compliant setup",
    icon: "verified"
  }
];
---

<section class="relative w-full pt-20 pb-10 sm:pt-28 sm:pb-14 md:pt-36 md:pb-20 lg:pt-40 lg:pb-22 bg-[#FAF8FF] overflow-hidden">
  <!-- Background Glow Accents -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="absolute -top-20 -left-20 w-[450px] h-[450px] bg-[#3393D1]/15 rounded-full blur-[120px]"></div>
    <div class="absolute top-1/3 right-0 w-[500px] h-[500px] bg-[#006947]/10 rounded-full blur-[140px]"></div>
    <div class="absolute -bottom-20 left-1/3 w-[400px] h-[400px] bg-[#007BB7]/10 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Top Row: Value Proposition & Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Value Proposition & Proof -->
      <div class="lg:col-span-7 flex flex-col gap-4 sm:gap-7">
        
        <!-- Category Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-4 sm:py-1.5 rounded-full bg-gradient-to-r from-[#EAEDFF] via-[#F2F3FF] to-white border border-[#3393D1]/30 text-[#006192] shadow-sm shadow-[#3393D1]/10 w-fit">
          <span class="flex h-2 w-2 sm:h-2.5 sm:w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 sm:h-2.5 sm:w-2.5 bg-[#10B981]"></span>
          </span>
          <span class="text-[10px] sm:text-xs font-extrabold tracking-wider uppercase text-[#006192]">
            COMPANY REGISTRATION IN OMAN
          </span>
        </div>

        <!-- Main Headline -->
        <div class="space-y-2.5 sm:space-y-4">
          <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-[46px] xl:text-[52px] font-extrabold text-[#131B2E] tracking-tight leading-[1.18] sm:leading-[1.16] [text-wrap:balance]">
            Company Registration in Oman
            <span class="relative inline-block ml-1 sm:ml-1.5 mt-0.5 sm:mt-0">
              <span class="bg-gradient-to-r from-[#006192] via-[#3393D1] to-[#007BB7] bg-clip-text text-transparent italic font-semibold">
                Made Simple
              </span>
              <!-- Premium curved underline stroke -->
              <svg class="absolute w-full h-2.5 sm:h-3.5 -bottom-1 sm:-bottom-2 left-0 text-[#3393D1] opacity-80" viewBox="0 0 170 16" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M3 10.5C48 3.5 122 3.5 167 10.5C130 6.5 78 6.5 3 13" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" />
              </svg>
            </span>
          </h1>

          <p class="text-xs sm:text-base md:text-lg text-[#475569] font-normal leading-relaxed max-w-2xl pt-0.5 sm:pt-1">
            Start your business in Oman with simple and complete company registration support. From <span class="font-semibold text-[#131B2E]">trade name reservation</span> and <span class="font-semibold text-[#131B2E]">CR registration</span> to <span class="font-semibold text-[#131B2E]">licensing</span>, we guide you through the process.
          </p>
        </div>

        <!-- Key Value Checklist -->
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3.5 pt-0.5 sm:pt-1">
          <li class="flex items-center gap-2.5 sm:gap-3 bg-white/90 backdrop-blur-md p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-[#E2E8F0] shadow-sm hover:border-[#3393D1]/40 hover:shadow-md transition-all duration-200">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-[#006947]/10 text-[#006947] flex items-center justify-center shrink-0 shadow-inner">
              <span class="material-symbols-outlined text-[16px] sm:text-[19px] font-bold">verified</span>
            </div>
            <span class="text-xs sm:text-sm font-bold text-[#131B2E]">100% Foreign Ownership Setup</span>
          </li>

          <li class="flex items-center gap-2.5 sm:gap-3 bg-white/90 backdrop-blur-md p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-[#E2E8F0] shadow-sm hover:border-[#3393D1]/40 hover:shadow-md transition-all duration-200">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-[#006947]/10 text-[#006947] flex items-center justify-center shrink-0 shadow-inner">
              <span class="material-symbols-outlined text-[16px] sm:text-[19px] font-bold">speed</span>
            </div>
            <span class="text-xs sm:text-sm font-bold text-[#131B2E]">Express CR in 3 to 5 Days</span>
          </li>

          <li class="flex items-center gap-2.5 sm:gap-3 bg-white/90 backdrop-blur-md p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-[#E2E8F0] shadow-sm hover:border-[#3393D1]/40 hover:shadow-md transition-all duration-200">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-[#006947]/10 text-[#006947] flex items-center justify-center shrink-0 shadow-inner">
              <span class="material-symbols-outlined text-[16px] sm:text-[19px] font-bold">payments</span>
            </div>
            <span class="text-xs sm:text-sm font-bold text-[#131B2E]">0% Personal Income Tax</span>
          </li>

          <li class="flex items-center gap-2.5 sm:gap-3 bg-white/90 backdrop-blur-md p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-[#E2E8F0] shadow-sm hover:border-[#3393D1]/40 hover:shadow-md transition-all duration-200">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-[#006947]/10 text-[#006947] flex items-center justify-center shrink-0 shadow-inner">
              <span class="material-symbols-outlined text-[16px] sm:text-[19px] font-bold">support_agent</span>
            </div>
            <span class="text-xs sm:text-sm font-bold text-[#131B2E]">Dedicated Bilingual Advisor</span>
          </li>
        </ul>

        <!-- Social Proof Trust Stack -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2 sm:pt-3 border-t border-[#E2E8F0]">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border-2 border-white bg-gradient-to-tr from-[#006192] to-[#3393D1] text-white flex items-center justify-center font-bold text-[10px] sm:text-xs shadow-md">
              OM
            </div>
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border-2 border-white bg-gradient-to-tr from-[#10B981] to-[#059669] text-white flex items-center justify-center font-bold text-[10px] sm:text-xs shadow-md">
              GCC
            </div>
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border-2 border-white bg-gradient-to-tr from-[#007BB7] to-[#85C8FE] text-white flex items-center justify-center font-bold text-[10px] sm:text-xs shadow-md">
              EU
            </div>
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border-2 border-white bg-[#EAEDFF] text-[#006192] flex items-center justify-center font-extrabold text-[10px] sm:text-xs shadow-md border-[#CBD5E1]">
              +5k
            </div>
          </div>
          
          <div class="flex flex-col">
            <div class="flex items-center gap-1 text-[#F59E0B]">
              <div class="flex">
                <span class="material-symbols-outlined text-[15px] sm:text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[15px] sm:text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[15px] sm:text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[15px] sm:text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-[15px] sm:text-[18px]" style="font-variation-settings: 'FILL' 1;">star_half</span>
              </div>
              <span class="text-[11px] sm:text-xs font-bold text-[#131B2E]">4.5 / 5.0 Rating</span>
            </div>
            <span class="text-[10px] sm:text-xs font-medium text-[#475569]">
              Trusted by 5,000+ Businesses & Global Investors in Oman
            </span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Lead Capture Form Card -->
      <div class="lg:col-span-5 w-full">
        <LeadForm />
      </div>

    </div>

    <!-- Integrated Metrics & Stats Strip in Hero -->
    <div class="mt-12 sm:mt-16 pt-8 border-t border-[#E2E8F0]">
      <div class="bg-white/90 backdrop-blur-md rounded-2xl sm:rounded-3xl p-4 sm:p-6 border border-[#E2E8F0] shadow-sm hover:shadow-md transition-shadow">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:divide-x lg:divide-[#E2E8F0]">
          {stats.map((item, index) => (
            <div class={`flex items-center gap-3 sm:gap-4 p-2 sm:p-3 group ${index !== 0 ? 'lg:pl-6' : ''}`}>
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#EAEDFF] text-[#006192] flex items-center justify-center shrink-0 group-hover:bg-[#3393D1] group-hover:text-white transition-all duration-300 shadow-sm">
                <span class="material-symbols-outlined text-[22px] sm:text-[24px]">
                  {item.icon}
                </span>
              </div>
              
              <div class="min-w-0">
                <div class="text-xl sm:text-2xl lg:text-[28px] font-extrabold text-[#131B2E] tracking-tight leading-none group-hover:text-[#006192] transition-colors">
                  {item.value}
                </div>
                <div class="text-xs sm:text-sm font-bold text-[#006192] mt-1 truncate">
                  {item.label}
                </div>
                <div class="text-[11px] text-[#475569] font-medium hidden sm:block truncate mt-0.5">
                  {item.subtext}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

