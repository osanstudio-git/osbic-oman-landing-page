---
// Smart Call Modal for Desktop Browsers
// Prevents the raw OS "Pick an app" browser prompt and displays a sleek hotline & copy modal.
---

<div
  id="call-modal-backdrop"
  class="fixed inset-0 z-[100] bg-[#001D30]/60 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="call-modal-title"
>
  <!-- Modal Card -->
  <div
    id="call-modal-card"
    class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-[#E2E8F0] relative scale-95 opacity-0 transition-all duration-300 text-center"
  >
    <!-- Close Button -->
    <button
      id="call-modal-close"
      aria-label="Close modal"
      class="absolute top-4 right-4 w-9 h-9 rounded-full bg-[#F1F5F9] hover:bg-[#E2E8F0] text-[#475569] hover:text-[#131B2E] flex items-center justify-center transition-all"
    >
      <span class="material-symbols-outlined text-[20px]">close</span>
    </button>

    <!-- OSBIC Logo Header -->
    <div class="w-16 h-16 rounded-2xl overflow-hidden shadow-md border border-[#3393D1]/20 flex items-center justify-center mx-auto mb-3 bg-white">
      <img
        src="/Artboard 1@3x-1.png"
        alt="OSBIC Logo"
        class="w-full h-full object-cover scale-[1.04]"
        loading="eager"
      />
    </div>

    <!-- Title & Subtitle -->
    <h3 id="call-modal-title" class="text-2xl font-black text-[#006192] tracking-tight">
      OSBIC
    </h3>
    <p class="text-xs sm:text-sm font-bold text-[#475569] mt-0.5 mb-5 tracking-wide">
      Company Registration in Oman
    </p>

    <!-- Big Phone Number Card -->
    <div class="bg-[#FAF8FF] border border-[#EAEDFF] rounded-2xl p-4 mb-4">
      <span class="text-[11px] font-bold text-[#006192] uppercase tracking-wider block mb-1">
        Official Contact Number
      </span>
      <div class="text-2xl sm:text-3xl font-black text-[#131B2E] tracking-tight font-mono select-all">
        +968 7259 6531
      </div>
    </div>

    <!-- Primary Actions: Copy & WhatsApp -->
    <div class="space-y-3">
      <!-- Copy Number Button -->
      <button
        id="call-modal-copy-btn"
        class="w-full h-12 rounded-xl bg-[#EAEDFF] hover:bg-[#DFE5FF] text-[#006192] font-extrabold text-sm flex items-center justify-center gap-2 active:scale-95 transition-all shadow-sm border border-[#CBD5E1]/60"
      >
        <span id="copy-icon" class="material-symbols-outlined text-[18px]">content_copy</span>
        <span id="copy-text">Copy Phone Number</span>
      </button>

      <!-- Chat on WhatsApp Button -->
      <a
        href="https://api.whatsapp.com/send?phone=96872596531&text=Hello%20OSBIC%20Team%2C%20I%20would%20like%20to%20get%20a%20Free%20Consultation."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full h-12 rounded-xl bg-gradient-to-r from-[#10B981] to-[#059669] hover:from-[#059669] hover:to-[#047857] text-white font-extrabold text-sm flex items-center justify-center gap-2 active:scale-95 transition-all shadow-md shadow-emerald-600/30"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
        </svg>
        <span>Continue on WhatsApp</span>
      </a>
    </div>

    <!-- Direct dial fallback for desktop users with calling apps -->
    <div class="mt-4 pt-3 border-t border-[#E2E8F0] text-center">
      <a
        href="tel:+96872596531"
        data-native-dial="true"
        class="text-xs text-[#64748B] hover:text-[#006192] transition-colors underline font-medium"
      >
        Have a desktop phone app installed? Click to dial
      </a>
    </div>
  </div>
</div>

<script is:inline>
  function initCallModal() {
    const backdrop = document.getElementById('call-modal-backdrop');
    const card = document.getElementById('call-modal-card');
    const closeBtn = document.getElementById('call-modal-close');
    const copyBtn = document.getElementById('call-modal-copy-btn');
    const copyIcon = document.getElementById('copy-icon');
    const copyText = document.getElementById('copy-text');
    const phoneNumber = '+968 7259 6531';

    function isMobileDevice() {
      return (
        /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ||
        window.matchMedia('(max-width: 768px)').matches
      );
    }

    function openModal() {
      if (!backdrop || !card) return;
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      card.classList.remove('scale-95', 'opacity-0');
      card.classList.add('scale-100', 'opacity-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!backdrop || !card) return;
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-100', 'opacity-100');
      card.classList.add('scale-95', 'opacity-0');
      document.body.style.overflow = '';
      
      // Reset copy button
      if (copyText && copyIcon) {
        copyText.textContent = 'Copy Phone Number';
        copyIcon.textContent = 'content_copy';
        copyBtn?.classList.remove('bg-[#10B981]', 'text-white', 'border-[#10B981]');
        copyBtn?.classList.add('bg-[#EAEDFF]', 'text-[#006192]', 'border-[#CBD5E1]/60');
      }
    }

    // Intercept all tel: links on desktop
    document.addEventListener('click', (e) => {
      const target = e.target.closest('a[href^="tel:"]');
      if (!target) return;

      // If user clicked the explicit native dial fallback inside modal, let it proceed
      if (target.getAttribute('data-native-dial') === 'true') {
        return;
      }

      // If mobile phone, allow default dialer to open
      if (isMobileDevice()) {
        return;
      }

      // Desktop: prevent Windows app-picker prompt and show beautiful modal
      e.preventDefault();
      openModal();
    });

    // Close on button click
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    // Close on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop?.classList.contains('opacity-100')) {
        closeModal();
      }
    });

    // Copy to clipboard functionality
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(phoneNumber.replace(/\s+/g, ' '));
        if (copyText && copyIcon) {
          copyText.textContent = 'Copied to Clipboard! ✓';
          copyIcon.textContent = 'check_circle';
          copyBtn.classList.remove('bg-[#EAEDFF]', 'text-[#006192]', 'border-[#CBD5E1]/60');
          copyBtn.classList.add('bg-[#10B981]', 'text-white', 'border-[#10B981]');
        }
        setTimeout(() => {
          if (copyText && copyIcon) {
            copyText.textContent = 'Copy Phone Number';
            copyIcon.textContent = 'content_copy';
            copyBtn.classList.remove('bg-[#10B981]', 'text-white', 'border-[#10B981]');
            copyBtn.classList.add('bg-[#EAEDFF]', 'text-[#006192]', 'border-[#CBD5E1]/60');
          }
        }, 3000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCallModal);
  } else {
    initCallModal();
  }
</script>
