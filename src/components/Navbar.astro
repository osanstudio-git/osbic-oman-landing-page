---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
---

<header class="fixed top-0 inset-x-0 w-full z-50 bg-[#FAF8FF]/90 backdrop-blur-xl border-b border-[#E2E8F0] transition-all duration-200">
  <!-- Trust Bar (Desktop only micro-banner) -->
  <div class="hidden lg:block bg-gradient-to-r from-[#006192] to-[#3393D1] text-white py-1.5 px-4 text-xs font-medium">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-[#6FFBBE]">verified</span>
          Official Ministry of Commerce & Industry Licensing
        </span>
        <span class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-[#6FFBBE]">public</span>
          100% Foreign Ownership Advisory
        </span>
      </div>
      <div class="flex items-center gap-6">
        <!-- <span class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-[#6FFBBE]">schedule</span>
          24/7 Fast-Track Response
        </span>  -->
        <a href="mailto:marketing@osbic.net" class="hover:text-white/80 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">mail</span>
          marketing@osbic.net
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="h-14 sm:h-16 md:h-20 flex items-center justify-between gap-2 sm:gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 sm:gap-3 group shrink-0">
        <div class="w-8 h-8 sm:w-10 sm:h-10 md:w-11 md:h-11 rounded-lg sm:rounded-xl overflow-hidden shadow-sm group-hover:shadow-md transition-all flex items-center justify-center shrink-0 border border-[#3393D1]/20">
          <Image
            src={logoImg}
            alt="OSBIC Logo"
            class="w-full h-full object-cover scale-[1.04]"
            loading="eager"
            width={88}
            height={88}
            format="webp"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-lg sm:text-xl md:text-2xl text-[#006192] tracking-tight leading-none group-hover:text-[#3393D1] transition-colors">
            OSBIC
          </span>
          <span class="text-[8px] sm:text-[9.5px] md:text-[10px] font-semibold text-[#475569] tracking-wider uppercase leading-tight mt-0.5">
            COMPANY REGISTRATION IN OMAN
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-[#3F4850]">
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-4 shrink-0">
        <a
          href="tel:+96872596531"
          class="hidden sm:flex items-center gap-2 text-sm font-semibold text-[#131B2E] hover:text-[#3393D1] px-3 py-2 rounded-lg hover:bg-[#EAEDFF] transition-all"
        >
          <span class="w-8 h-8 rounded-full bg-[#EAEDFF] text-[#006192] flex items-center justify-center">
            <span class="material-symbols-outlined text-[18px]">call</span>
          </span>
          <span class="hidden md:inline">+968 7259 6531</span>
        </a>

        <a
          href="#lead-form"
          class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-5 md:px-6 py-2 sm:py-2.5 md:py-3 rounded-lg sm:rounded-xl bg-[#3393D1] hover:bg-[#1F6E9F] text-white text-xs sm:text-sm font-bold shadow-sm sm:shadow-md shadow-[#3393D1]/20 hover:shadow-lg hover:shadow-[#3393D1]/30 transition-all active:scale-[0.98] whitespace-nowrap"
        >
          <span class="sm:hidden">Get Consultation</span>
          <span class="hidden sm:inline">Get Free Consultation</span>
          
        </a>
      </div>
    </div>
  </div>
</header>
